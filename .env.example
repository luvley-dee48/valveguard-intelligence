# Copy to .env and fill in. Never commit .env.
SECRET_KEY=                                       # leave empty to auto-generate .secret_key, or set a long random string
GEMINI_API_KEY=                                   # from Google AI Studio; leave empty to use the rule-based fallback
GEMINI_MODEL=gemma-4-26b-a4b-it                   # or gemma-4-31b-it
RESPAN_API_KEY=                                   # from platform.respan.ai > Gateway > API keys; leave empty to run without tracing
DATABASE_URL=sqlite:///./valveguard.db            # any SQLAlchemy URL, e.g. postgresql+psycopg://user:pass@host/db
TOKEN_HOURS=12
AI_CALLS_PER_HOUR=30
# CORS_ORIGINS=https://your-frontend.example      # only needed if the frontend is hosted on another origin
