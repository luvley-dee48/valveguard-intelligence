# Copy to .env and fill in. Never commit .env.
SECRET_KEY=change-me-to-a-long-random-string      # python -c "import secrets;print(secrets.token_urlsafe(48))"
GEMINI_API_KEY=                                   # from Google AI Studio; leave empty to use the rule-based fallback
GEMINI_MODEL=gemma-4-26b-a4b-it                   # or gemma-4-31b-it
DATABASE_URL=sqlite:///./nexora.db                # any SQLAlchemy URL, e.g. postgresql+psycopg://user:pass@host/db
SEED_DEMO_DATA=true                               # set false for a clean production database
TOKEN_HOURS=12
AI_CALLS_PER_HOUR=30
# CORS_ORIGINS=https://your-frontend.example      # only needed if the frontend is hosted on another origin
